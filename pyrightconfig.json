{
  "include": ["firmware"],
  "exclude": ["firmware/tests", "tools", ".venv", "work", "**/__pycache__"],
  "typeCheckingMode": "standard",
  "reportMissingModuleSource": false,
  "stubPath": "work/micropython-stubs",
